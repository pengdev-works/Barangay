# =============================================================
# BarangayConnect Backend Environment Variables
# =============================================================

# Neon PostgreSQL Connection String
# Get this from: https://console.neon.tech → Your Project → Connection Details
DATABASE_URL=postgresql://username:password@ep-xxxx.us-east-2.aws.neon.tech/barangayconnect?sslmode=require

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS) - change to your Vercel URL after deployment
FRONTEND_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads
